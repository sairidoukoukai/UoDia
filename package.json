{
  "name": "uodia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大阪大学 学内連絡バス（再履バス）ダイヤグラム設計ソフトウェア",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/tauri-dev.mjs",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/cli": "^2.2.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
