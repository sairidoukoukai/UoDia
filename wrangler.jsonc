{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uodia",
  "compatibility_date": "2026-08-12",

  /*
    **スクリプトを持たない。** `main`を書かなければ、この Worker は`dist/`を
    配るだけのものになる。UoDia は起動してから先をブラウザの中だけで完結させ、
    送る先が無い——保存も読込も利用者の手元で行われる。
  */
  "assets": {
    "directory": "./dist",
    /*
      当たらないURLには`index.html`を200で返す。画面は1枚であり、
      `/どこか`を直接開かれても起動する。
    */
    "not_found_handling": "single-page-application",
  },

  "routes": [{ "pattern": "uodia.sairibus.com", "custom_domain": true }],

  /*
    **この2つは開けない。** `workers.dev`と版ごとのプレビューURLは
    `uodia.sairibus.com`とは別のホスト名であり、そこに置いたAccessは掛からない。
    開けたままにすると、限定したはずの中身へ素通りの道が残る。
  */
  "workers_dev": false,
  "preview_urls": false,
}
